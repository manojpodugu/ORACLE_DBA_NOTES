whoami  --> Check current user
sudo su - oracle --> Switch to oracle user
lsnrctl status --> Check listener // ((DESCRIPTION=(ADDRESS=(PROTOCOL=tcp)(HOST=testserver01)(PORT=1521))))
ps -ef | grep pmon --> Check instance. // oracle    109594       1  0 Jul28 ?        00:00:07 ora_pmon_ORCLCDB

sqlplus / as sysdba --> Connect as SYSDBA. Everything after this point is run inside SQL*Plus. // {SQL> }

# NOTE: 
Linux User  : oracle
Oracle User : SYS
Privilege   : SYSDBA

SHOW USER; --> to see which user you logged in as;

SELECT name FROM v$database; --> discover basic database information. // ORCLCDB

SELECT instance_name,status FROM v$instance; --> Check instance. // INSTANCE_NAME    STATUS

SELECT username FROM dba_users ORDER BY username; --> Explore All Users (Schemas). Every Oracle user generally owns a schema.
